    <string name="privacy_policy_title">Privacy Policy</string>
    <string name="privacy_policy_updated">Last updated: July 27, 2026</string>
    <string name="privacy_policy_intro">Num Conversion (\"the app\") is a calculator and unit-conversion utility. This policy explains how the app handles information.</string>

    <string name="privacy_policy_heading_collection">Data Collection</string>
    <string name="privacy_policy_body_collection">The app does not collect, transmit, or share any personal or sensitive information. It has no internet or network access, no advertising, no analytics, and no third-party SDKs of any kind.</string>

    <string name="privacy_policy_heading_stored">Data Stored On Your Device</string>
    <string name="privacy_policy_body_stored">The app saves a small set of preferences locally on your device only: your chosen color palette, theme, haptic feedback preference, fraction-rounding precision, and the last unit pair you used in the converter.</string>
    <string name="privacy_policy_body_history">Your calculation and conversion history is kept in memory only while the app is open, and is cleared automatically when the app is closed. It is never written to disk or sent anywhere.</string>
    <string name="privacy_policy_body_leaves">None of this information ever leaves your device. Uninstalling the app permanently removes all locally stored preferences.</string>

    <string name="privacy_policy_heading_permissions">Permissions</string>
    <string name="privacy_policy_body_permissions">The app requests no runtime or special Android permissions.</string>

    <string name="privacy_policy_heading_children">Children\'s Privacy</string>
    <string name="privacy_policy_body_children">The app is a general-purpose utility not directed at children and does not knowingly collect information from anyone, regardless of age.</string>

    <string name="privacy_policy_heading_contact">Contact</string>
    <string name="privacy_policy_body_contact">Questions about this policy can be sent to: firfghr25@gmail.com</string>
